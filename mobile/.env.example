# Default SENTINEL server the app pre-fills on the setup screen.
# Users can override this in-app; it is only a starting value.
EXPO_PUBLIC_SENTINEL_URL=https://camera.tapanmeena.com

# One Auth (AuthKit) issuer URL for mobile authentication.
EXPO_PUBLIC_AUTHKIT_URL=https://auth.tapanmeena.com

# Optional: set when linking the project to an EAS account.
# EAS_PROJECT_ID=
